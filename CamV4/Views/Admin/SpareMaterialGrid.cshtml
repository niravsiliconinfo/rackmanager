<style>
    [ng-cloak] { display: none !important; }
</style>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@{
    var userType = Session["LoggedInUserType"] != null ? Session["LoggedInUserType"].ToString() : "1";
    var fileId = Request.QueryString["fileId"];
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/plugins/css/pluginsCss.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/plugins/plugins.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/css/luckysheet.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/assets/iconfont/iconfont.css" />
<script src="https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/plugins/js/plugin.js"></script>
<script src="https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/luckysheet.umd.js"></script>
<script src="~/NgScript/Controller/inventoryGridCtrl.js"></script>

<style>
    #luckysheet-container {
        width: 100%;
        height: 65vh;
        min-height: 460px;
        position: relative;
    }

    .grid-footer {
        padding: 5px 14px;
        background: #f6f8fa;
        border-top: 1px solid #d0d7de;
        font-size: 12px;
        color: #57606a;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 6px;
    }

    .unsaved-banner {
        background: #fff8e1;
        border-left: 4px solid #f5a623;
        padding: 8px 14px;
        font-size: 13px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 0 4px 4px 0;
    }

    .grid-toolbar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding: 10px 15px;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

        .grid-toolbar .btn {
            min-width: 120px;
            height: 36px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 4px;
        }

            .grid-toolbar .btn:disabled,
            .grid-toolbar .btn.disabled {
                opacity: 1;
                background: #e9ecef;
                color: #6c757d;
                border-color: #ced4da;
                cursor: not-allowed;
            }

    .tsep {
        width: 1px;
        height: 26px;
        background: #ced4da;
        margin: 0 6px;
    }
</style>

<main ng-cloak class="main-content2 position-relative max-height-vh-100 h-100"
      ng-app="myApp" ng-controller="inventoryGridCtrl">

    <input type="hidden" ng-model="fileId" ng-init="fileId='@fileId'" />

    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none"
         id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    @if (userType == "1")
                    {
                        <li class="breadcrumb-item text-sm">
                            <a class="opacity-5 text-dark" href="@Url.Action("Index","Admin")">Dashboard</a>
                        </li>
                    }
                    else
                    {
                        <li class="breadcrumb-item text-sm">
                            <a class="opacity-5 text-dark" href="@Url.Action("Index","Employee")">Dashboard</a>
                        </li>
                    }
                    <li class="breadcrumb-item text-sm">
                        <a class="opacity-5 text-dark" href="javascript:history.back()">Spare Materials</a>
                    </li>
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">
                        {{currentFile.FileName || 'Grid Editor'}}
                    </li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserFullName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <ul class="navbar-nav ms-auto justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login","Account")"
                           class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                    <li class="nav-item d-xl-none ps-3 d-flex align-items-center">
                        <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                            <div class="sidenav-toggler-inner">
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4">

        <div class="alert alert-danger mb-3" ng-if="gridError">{{gridError}}</div>
        <div class="alert alert-success mb-3" ng-if="gridSuccess">{{gridSuccess}}</div>

        <div class="unsaved-banner" ng-if="hasUnsavedChanges">
            <span><strong>Unsaved changes</strong> &mdash; your edits are not yet saved.</span>
            <div class="d-flex gap-2">
                <button type="button" ng-click="DiscardChanges()"
                        class="btn btn-sm  btn-secondary mb-0">
                    Discard
                </button>
                <button type="button" ng-click="SaveAll()"
                        class="btn btn-sm btn-primary mb-0" ng-disabled="saving">
                    {{saving ? 'Saving...' : 'Save Changes'}}
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="d-flex justify-content-between align-items-center pt-4 pb-4 px-3">
                            <div>
                                <h6 class="text-white text-capitalize mb-0">
                                    {{currentFile.FileName || 'Spare Material Grid'}}
                                </h6>
                                <p class="text-white text-xs mb-0 opacity-8" ng-if="currentFile.LocationName">
                                    {{currentFile.LocationName}}
                                    <span ng-if="currentFile.FacilityName"> &rsaquo; {{currentFile.FacilityName}}</span>
                                    <span ng-if="currentFile.AreaName"> &rsaquo; {{currentFile.AreaName}}</span>
                                    &nbsp;&middot;&nbsp; {{rowCount | number}} rows
                                    &nbsp;&middot;&nbsp; {{headers.length}} cols
                                </p>
                            </div>
                            <a href="javascript:history.back()"
                               class="btn btn-sm bg-gradient-secondary mb-0">
                                Back to Files
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-0">

                        <div ng-if="loading" style="padding:60px;text-align:center;">
                            <div class="spinner-border text-success" role="status"
                                 style="width:3rem;height:3rem;"></div>
                            <p class="text-sm text-secondary mt-3 mb-0">Loading spreadsheet...</p>
                        </div>

                        <div ng-if="!loading">
                            <div class="grid-toolbar">

                                <!-- Row operations -->
                                <button type="button"
                                        ng-click="AddRow()"
                                        class="btn btn-sm btn-success mb-0"
                                        title="Append a blank row">
                                    Add Row
                                </button>

                                <button type="button"
                                        ng-click="DeleteSelectedRows()"
                                        class="btn btn-sm btn-danger mb-0"
                                        title="Delete selected rows (select rows in grid first)">
                                    Delete Row(s)
                                </button>

                                <div class="tsep"></div>

                                <!-- Save -->
                                <button type="button"
                                        ng-click="SaveAll()"
                                        class="btn btn-sm btn-primary mb-0"
                                        ng-disabled="saving || !hasUnsavedChanges"
                                        title="Save all changes to the database">
                                    {{saving ? 'Saving...' : 'Save'}}
                                </button>

                                <button type="button"
                                        ng-click="DiscardChanges()"
                                        class="btn btn-sm btn-secondary mb-0"
                                        ng-show="hasUnsavedChanges"
                                        title="Revert to last saved state">
                                    Discard
                                </button>

                                <div class="tsep"></div>

                                <!-- Export -->
                                <button type="button"
                                        ng-click="ExportGrid()"
                                        class="btn btn-sm btn-secondary mb-0"
                                        title="Download current data as .xlsx">
                                    Export Excel
                                </button>

                            </div>

                            <div id="luckysheet-container"></div>

                            <div class="grid-footer">
                                <span>{{rowCount | number}} rows &nbsp;&middot;&nbsp; {{headers.length}} columns</span>
                                <span>Tab = next column &nbsp; Enter = next row &nbsp; Ctrl+Z = undo</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.Partial("_FooterLayout")
</main>
