@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<script src="~/NgScript/Controller/manufacturerCtrl.js"></script>
<main class="main-content2 position-relative max-height-vh-100 h-100"
      ng-app="myApp"
      ng-controller="manufacturerCtrl">

    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card my-4">

                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4 d-flex justify-content-between align-items-center">
                            <h6 class="text-white ps-3 mb-0">Manage Manufacturer</h6>
                            <button class="btn bg-gradient-dark me-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#manufacturerModal"
                                    ng-click="resetManufacturer()">
                                <i class="material-icons text-sm me-1">add</i>
                                Add Manufacturer
                            </button>
                        </div>
                    </div>

                    <div class="card-body px-0 pb-2">
                        <div class="table-responsive p-0">
                            <table id="manufacturerTable"
                                   class="table table-striped align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            Manufacturer Name
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                                            Type
                                        </th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center" style="width:120px">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="d in getAllManufacturer">
                                        <td>
                                            <div class="d-flex px-2 py-1">
                                                <div class="d-flex flex-column justify-content-center">
                                                    <h6 class="mb-0 text-sm">{{d.ManufacturerName}}</h6>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <p class="text-xs font-weight-bold mb-0">
                                                {{getManufacturerTypeText(d.ManufacturerType)}}
                                            </p>
                                        </td>
                                        <td class="align-middle text-center">
                                            <a href="javascript:void(0)"
                                               class="text-secondary font-weight-bold text-xs me-2"
                                               ng-click="editManufacturer(d)"
                                               data-bs-toggle="modal"
                                               data-bs-target="#manufacturerModal"
                                               title="Edit">
                                                <i class="material-icons text-sm">edit</i>
                                            </a>
                                            <a href="javascript:void(0)"
                                               class="text-danger font-weight-bold text-xs"
                                               ng-click="ManufacturerId=d.ManufacturerId"
                                               data-bs-toggle="modal"
                                               data-bs-target="#deleteModal"
                                               title="Delete">
                                                <i class="material-icons text-sm">delete</i>
                                            </a>
                                        </td>
                                    </tr>
                                    <tr ng-if="getAllManufacturer.length === 0">
                                        <td colspan="3" class="text-center text-sm py-4">
                                            <i class="material-icons text-lg opacity-5">inbox</i>
                                            <p class="mb-0 mt-2">No manufacturers found. Click "Add Manufacturer" to create one.</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- ADD / EDIT MODAL -->
    <div class="modal fade" id="manufacturerModal" tabindex="-1" role="dialog" aria-labelledby="manufacturerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="manufacturerModalLabel">
                        <i class="material-icons text-sm me-1">{{ManufacturerId > 0 ? 'edit' : 'add'}}</i>
                        {{ManufacturerId > 0 ? 'Edit Manufacturer' : 'Add Manufacturer'}}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="input-group input-group-outline mb-3">
                        <label class="form-label">Manufacturer Name *</label>
                        <input type="text"
                               class="form-control"
                               ng-model="manufacturerName"                               
                               required />
                    </div>
                    <div class="input-group input-group-outline mb-3">
                        <select class="form-control"
                                ng-model="ManufacturerType"
                                ng-options="t.id as t.name for t in manufacturerTypes"
                                required>
                            <option value="">-- Select Type *--</option>
                        </select>
                    </div>
                    <p class="text-xs text-secondary mb-0">* Required fields</p>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        <i class="material-icons text-sm me-1">close</i>
                        Cancel
                    </button>
                    <button type="button"
                            class="btn bg-gradient-info"
                            ng-click="saveOrUpdateManufacturer()">
                        <i class="material-icons text-sm me-1">{{ManufacturerId > 0 ? 'save' : 'add'}}</i>
                        {{ManufacturerId > 0 ? 'Update' : 'Save'}}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- DELETE MODAL -->
    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">
                        <i class="material-icons text-sm text-danger me-1">warning</i>
                        Confirm Delete
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body text-center py-4">
                    <i class="material-icons text-warning" style="font-size: 48px;">delete_forever</i>
                    <p class="mb-0 mt-3">Are you sure you want to delete this manufacturer?</p>
                    <p class="text-xs text-secondary mb-0">This action cannot be undone.</p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        <i class="material-icons text-sm me-1">close</i>
                        Cancel
                    </button>
                    <button type="button"
                            class="btn btn-danger"
                            ng-click="DeleteManufacturer(ManufacturerId)">
                        <i class="material-icons text-sm me-1">delete</i>
                        Delete
                    </button>
                </div>

            </div>
        </div>
    </div>

    @Html.Partial("_FooterLayout")
</main>

<script src="~/NgScript/Controller/manufacturerCtrl.js"></script>
