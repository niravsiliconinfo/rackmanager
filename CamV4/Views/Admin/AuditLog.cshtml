@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<script src="~/Scripts/ui-bootstrap-tpls-0.11.0.js"></script>
<script>
    // startFrom filter &mdash; required for ui-bootstrap pagination
    // Registered inline so no extra file needs to be deployed.
    // If your app.js already has this filter, remove this block.
    try {
        angular.module("myApp").filter("startFrom", function () {
            return function (input, start) {
                if (!Array.isArray(input)) return [];
                return input.slice(parseInt(start, 10) || 0);
            };
        });
    } catch(e) { /* already registered */ }
</script>
@{
    var userType = Session["LoggedInUserType"] != null
                    ? Session["LoggedInUserType"].ToString() : "1";
}
<script src="~/NgScript/Controller/auditLogCtrl.js"></script>

<main class="main-content2 position-relative max-height-vh-100 h-100"
      ng-app="myApp" ng-controller="auditLogCtrl">

    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none"
         id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm">
                        <a class="opacity-5 text-dark" href="@Url.Action("Index","Admin")">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item text-sm text-dark active"
                        aria-current="page">Spare Material Audit Log</li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserFullName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center">
                    <div class="input-group input-group-outline">
                        <input type="search" class="form-control"
                               placeholder="Search log..." ng-model="search"
                               id="example-search-input">
                    </div>
                </div>
                <ul class="navbar-nav justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login","Account")"
                           class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                    <li class="nav-item d-xl-none ps-3 d-flex align-items-center">
                        <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                            <div class="sidenav-toggler-inner">
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4">

        <!--  Filter Card  -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mb-0">
                                Filter Audit Log
                            </h6>
                        </div>
                    </div>
                    <div class="card-body pb-2">
                        <div class="row">
                            <div class="col-sm-2"><span>From Date</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <input type="date" class="form-control"
                                           ng-model="filter.fromDate" />
                                </div>
                            </div>
                            <div class="col-sm-2"><span>To Date</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <input type="date" class="form-control"
                                           ng-model="filter.toDate" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-2"><span>Location</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <select class="form-control" ng-model="filter.locationId">
                                        <option value="">-- All Locations --</option>
                                        <option ng-repeat="l in locationList"
                                                value="{{l.LocationID}}">
                                            {{l.LocationName}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2"><span>Action Type</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <select class="form-control" ng-model="filter.actionType">
                                        <option value="">-- All Actions --</option>
                                        <option value="Saved">Saved</option>
                                        <option value="Edited">Edited</option>
                                        <option value="Exported">Exported</option>
                                        <option value="Uploaded">Uploaded</option>
                                        <option value="Deleted">Deleted</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="text-center float-end mt-3">
                            <button type="button" ng-click="ApplyFilter()"
                                    class="btn btn-lg bg-gradient-info mt-2 mb-0">
                                Search
                            </button>
                            <button type="button" ng-click="ClearFilter()"
                                    class="btn btn-lg bg-gradient-secondary mt-2 mb-0 ms-2">
                                Clear
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--  Audit Log Table  -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4" id="tblAuditLog">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mb-0">
                                Audit Log ({{auditList.length}} records)
                            </h6>
                        </div>
                    </div>
                    <div class="card-body pb-2">
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Date/Time</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">User</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Action</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Location</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">File</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Details</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">IP Address</th>
                                    </tr>
                                </thead>
                                <tbody ng-repeat="a in auditList | filter:search | startFrom:(currentPage-1)*itemsPerPage | limitTo:itemsPerPage">
                                    <tr>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs font-weight-bold">
                                                {{a.DateTime}}
                                            </span>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs font-weight-bold">
                                                {{a.UserName}}
                                            </span>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <h6 class="badge badge-sm"
                                                ng-class="
                                                    a.Action=='Saved'     ? 'bg-gradient-completed'       :
                                                    a.Action=='Deleted'   ? 'bg-gradient-due'             :
                                                    a.Action=='Exported'  ? 'bg-gradient-info'            :
                                                    a.Action=='Uploaded'  ? 'bg-gradient-repaircompleted' :
                                                                            'bg-gradient-sendforapproval'">
                                                {{a.Action}}
                                            </h6>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <h6 class="badge badge-sm bg-gradient-info">
                                                {{a.LocationName}}
                                            </h6>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs">
                                                {{a.FileName}}
                                            </span>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs">
                                                {{a.Details}}
                                            </span>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs">
                                                {{a.IPAddress}}
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                                <tbody ng-if="auditList.length == 0">
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            No audit records found.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <nav class="mt-2">
                                Show
                                <select ng-model="viewby"
                                        ng-change="setItemsPerPage(viewby)"
                                        style="height:25px">
                                    <option>10</option>
                                    <option>20</option>
                                    <option>50</option>
                                </select>
                                of {{auditList.length}} Records
                                <pagination
                                    total-items="auditList.length"
                                    ng-model="currentPage"
                                    max-size="maxSize"
                                    class="pagination"
                                    rotate="false"
                                    num-pages="numPages"
                                    items-per-page="itemsPerPage"
                                    previous-text="&laquo;"
                                    next-text="&raquo;">
                                </pagination>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    @Html.Partial("_FooterLayout")
</main>
