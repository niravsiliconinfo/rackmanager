@{
    ViewBag.Title = "Internal Inspections - Rack Manager - cam|industrial";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<script src="~/NgScript/Controller/adminInternalInspectionCtrl.js"></script>

<main class="main-content2 position-relative max-height-vh-100 h-100" ng-app="myApp" ng-controller="adminInternalInspectionCtrl">

    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none" id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm">
                        <a class="opacity-5 text-dark" href="@Url.Action("Index", "Admin")">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item text-sm">
                        <a class="opacity-5 text-dark" href="@Url.Action("CustomerList", "Admin")">Customers</a>
                    </li>
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">Internal Inspections</li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserFullName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center">
                    <div class="input-group input-group-outline">
                        <input type="search" class="form-control" placeholder="Search..."
                               ng-model="search" id="example-search-input">
                    </div>
                </div>
                <ul class="navbar-nav justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login", "Account")" class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                    <li class="nav-item d-xl-none ps-3 d-flex align-items-center">
                        <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                            <div class="sidenav-toggler-inner">
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card my-4">

                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <div class="row align-items-center">
                                <div class="col-6 d-flex align-items-center">
                                    <h6 class="text-white text-capitalize ps-3 mb-0">
                                        Internal Inspections
                                        <span ng-if="customerName" class="text-white-50 ms-2 text-sm">
                                            - {{customerName}}
                                        </span>
                                    </h6>
                                </div>
                                <div class="col-6 text-end pe-4">
                                    <span class="text-white text-sm">
                                        Total: {{allInspections.length || 0}}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Filter bar -->
                    <div class="card-body pb-0 pt-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="text-xs text-uppercase font-weight-bold">Status</label>
                                <select class="form-control form-control-sm" ng-model="filterStatus">
                                    <option value="">All Statuses</option>
                                    <option value="Submitted">Submitted</option>
                                    <option value="Under Review">Under Review</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="text-xs text-uppercase font-weight-bold">Date From</label>
                                <input type="date" class="form-control form-control-sm" ng-model="filterDateFrom">
                            </div>
                            <div class="col-md-3">
                                <label class="text-xs text-uppercase font-weight-bold">Date To</label>
                                <input type="date" class="form-control form-control-sm" ng-model="filterDateTo">
                            </div>
                            <div class="col-md-3">
                                <button class="btn btn-sm bg-gradient-dark mb-0 w-100"
                                        ng-click="applyFilter()">
                                    <i class="material-icons text-sm">filter_list</i>&nbsp; Filter
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pb-2">
                        <!-- Loading spinner -->
                        <div ng-if="loading" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted text-sm">Loading inspections...</p>
                        </div>

                        <div class="table-responsive p-0" ng-if="!loading">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Inspection #</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Date</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Customer</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Area,Facility,Location</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Region</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Deficiencies</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Eng. Review</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody ng-repeat="d in allInspections | filter:filterByStatus | filter:search | startFrom:(currentPage-1)*itemsPerPage | limitTo:itemsPerPage">
                                    <tr>
                                        <td class="align-middle">
                                            <span class="text-secondary text-xs font-weight-bold">{{d.InternalInspectionNumber}}</span>
                                        </td>
                                        <td class="align-middle">
                                            <span class="text-secondary text-xs font-weight-bold">{{d.InternalInspectionDateFormatted}}</span>
                                        </td>
                                        <td class="align-middle">
                                            <span class="text-secondary text-xs font-weight-bold">{{d.CustomerName}}</span>
                                        </td>
                                        <td class="align-middle">
                                            <p class="text-sm mb-0">
                                                <span class="text-secondary text-xs">
                                                    {{d.CustomerAreaName}}
                                                    <span ng-if="d.CustomerAreaName && (d.CustomerFacilityName || d.CustomerLocationName)">, </span>
                                                    <span ng-if="d.CustomerFacilityName">
                                                        {{d.CustomerFacilityName}}
                                                        <span ng-if="d.CustomerLocationName">, </span>
                                                    </span>
                                                    {{d.CustomerLocationName}}
                                                </span>
                                            </p>
                                        </td>
                                        <td class="align-middle">                                            
                                            <span class="text-xs text-muted">{{d.Region}}</span>
                                        </td>                                        
                                        <td class="align-middle text-center">
                                            <span class="badge bg-secondary badge-sm">{{d.DeficiencyCount}}</span>
                                            <span ng-if="d.SevereCount > 0" class="badge bg-danger badge-sm ms-1">{{d.SevereCount}} Severe</span>
                                        </td>
                                        <td class="align-middle text-center">
                                            <span ng-if="d.EngineerReviewCount > 0" class="badge bg-warning badge-sm">
                                                {{d.EngineerReviewCount}} (${{d.EngineerReviewTotalCost | number:2}})
                                            </span>
                                            <span ng-if="d.EngineerReviewCount === 0" class="text-xs text-muted">-</span>
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge badge-sm"
                                                  ng-class="{
                                                    'bg-warning' : d.Status === 'Submitted',
                                                    'bg-info'    : d.Status === 'Under Review',
                                                    'bg-success' : d.Status === 'Approved',
                                                    'bg-danger'  : d.Status === 'Rejected'
                                                  }">
                                                {{d.Status}}
                                            </span>
                                        </td>
                                        <td class="align-middle">
                                            <a href="@Url.Action("InternalInspectionView", "Admin")?id={{d.InternalInspectionID}}"
                                               title="View / Approve" class="me-2">
                                                <i class="material-icons text-lg">visibility</i>
                                            </a>
                                            <a href="javascript:;" title="Download PDF"
                                               ng-click="downloadPdf(d.InternalInspectionID)">
                                                <i class="material-icons text-lg">picture_as_pdf</i>
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                                <tbody ng-if="!loading && (!allInspections || allInspections.length === 0)">
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-4">
                                            No internal inspections found.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <nav class="mt-3 px-3 d-flex align-items-center">
                                Show
                                <select ng-model="viewby" ng-change="setItemsPerPage(viewby)"
                                        style="height:25px; margin:0 6px;">
                                    <option>10</option>
                                    <option>25</option>
                                    <option>50</option>
                                </select>
                                of {{(allInspections | filter:filterByStatus).length}} records
                                <pagination class="pagination ms-3 mb-0"
                                            total-items="totalItems"
                                            ng-model="currentPage"
                                            max-size="maxSize"
                                            rotate="false"
                                            num-pages="numPages"
                                            items-per-page="itemsPerPage"
                                            previous-text="<"
                                            next-text=">">
                                </pagination>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.Partial("_FooterLayout")
</main>
