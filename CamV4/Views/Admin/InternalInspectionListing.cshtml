@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@functions{
    public string GetAntiForgeryToken()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}
<script src="~/NgScript/Controller/internalInspectionCtrl.js"></script>

<main class="main-content2 position-relative max-height-vh-100 h-100 border-radius-lg"
      ng-controller="internalInspectionCtrl">

    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none border-radius-xl" id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="@Url.Action("ManageCustomer", "Admin")">Dashboard</a></li>
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">Internal Inspections</li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center"></div>
                <ul class="navbar-nav justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login", "Account")" class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4"
         ng-init="adminCustomerId='@Request.QueryString["id"]'">
        <input type="hidden" ng-model="antiForgeryToken" ng-init="antiForgeryToken='@GetAntiForgeryToken()'" />

        <!-- ===================== FILTER SECTION ===================== -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mt-2">Search Internal Inspections</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-2"><span>Customer</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <select class="form-control" ng-model="adminFilter.CustomerID"
                                            ng-change="onAdminCustomerChange()">
                                        <option value="">-- All Customers --</option>
                                        <option ng-repeat="c in allCustomers" value="{{c.CustomerID}}">
                                            {{c.CustomerName}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2"><span>Location</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <select class="form-control" ng-model="adminFilter.CustomerLocationID">
                                        <option value="">-- All Locations --</option>
                                        <option ng-repeat="l in adminLocationList" value="{{l.CustomerLocationID}}">
                                            {{l.LocationName}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-2"><span>Status</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <select class="form-control" ng-model="adminFilter.Status">
                                        <option value="">-- All Statuses --</option>
                                        <option value="Draft">Draft</option>
                                        <option value="Submitted">Submitted</option>
                                        <option value="Reviewed">Reviewed</option>
                                        <option value="Closed">Closed</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2"><span>Inspection #</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <input type="text" class="form-control" ng-model="adminFilter.InspectionNumber"
                                           placeholder="e.g. II-2026-0001" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-2"><span>Date From</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <input type="date" class="form-control" ng-model="adminFilter.DateFrom" />
                                </div>
                            </div>
                            <div class="col-sm-2"><span>Date To</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <input type="date" class="form-control" ng-model="adminFilter.DateTo" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-end">
                                <button type="button" class="btn bg-gradient-info btn-lg mt-2 mb-0"
                                        ng-click="SearchInspections()">
                                    <i class="material-icons text-sm me-1" style="vertical-align:middle;">search</i>
                                    Search
                                </button>
                                <button type="button" class="btn bg-gradient-secondary btn-lg mt-2 mb-0 ms-2"
                                        ng-click="ClearAdminFilter()">
                                    Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================== RESULTS GRID ===================== -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mt-2">
                                Results <span ng-if="inspectionList">({{inspectionList.length}})</span>
                            </h6>
                        </div>
                    </div>
                    <div class="card-body pb-2">
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Inspection #</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Customer</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Location</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Type of Rack</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Date</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Reported By</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Deficiencies</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Eng. Review</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Est. Cost</th>
                                        <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Status</th>
                                        <th class="text-secondary opacity-7"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-if="!inspectionList || inspectionList.length == 0">
                                        <td colspan="11" class="text-center text-sm py-3">
                                            No inspections found. Use the search filters above.
                                        </td>
                                    </tr>
                                    <tr ng-repeat="d in inspectionList | startFrom:(liPaging.current-1)*liPaging.size | limitTo:liPaging.size">
                                        <td>
                                            <p class="text-sm font-weight-bold mb-0 ps-2">{{d.InspectionNumber}}</p>
                                        </td>
                                        <td>
                                            <p class="text-sm mb-0">{{d.CustomerName}}</p>
                                        </td>
                                        <td>
                                            <p class="text-sm mb-0">{{d.CustomerLocationName}}</p>
                                        </td>
                                        <td>
                                            <p class="text-sm mb-0">{{d.TypeOfRack || '-'}}</p>
                                        </td>
                                        <td>
                                            <p class="text-sm mb-0">{{d.InspectionDateFormatted || '-'}}</p>
                                        </td>
                                        <td>
                                            <p class="text-sm mb-0">{{d.ReportedBy || '-'}}</p>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-gradient-secondary">{{d.DeficiencyCount}}</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-gradient-warning">{{d.EngineerReviewCount}}</span>
                                        </td>
                                        <td>
                                            <p class="text-sm mb-0">${{d.EngineerReviewTotalCost | number:2}}</p>
                                        </td>
                                        <td>
                                            <span class="badge bg-gradient-info"    ng-if="d.Status == 'Draft'">Draft</span>
                                            <span class="badge bg-gradient-primary" ng-if="d.Status == 'Submitted'">Submitted</span>
                                            <span class="badge bg-gradient-warning" ng-if="d.Status == 'Reviewed'">Reviewed</span>
                                            <span class="badge bg-gradient-success" ng-if="d.Status == 'Closed'">Closed</span>
                                        </td>
                                        <td class="align-middle">
                                            <a href="/Admin/adminInternalInspectionView?id={{d.InternalInspectionID}}"
                                               title="View">
                                                <i class="material-icons text-sm">visibility</i>
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Paging -->
                            <div class="d-flex justify-content-between align-items-center mt-3 px-2"
                                 ng-if="inspectionList && inspectionList.length > liPaging.size">
                                <span class="text-sm">
                                    Showing {{(liPaging.current-1)*liPaging.size+1}} -
                                    {{liPaging.current*liPaging.size > inspectionList.length ? inspectionList.length : liPaging.current*liPaging.size}}
                                    of {{inspectionList.length}}
                                </span>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item" ng-class="{disabled: liPaging.current == 1}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="prevPage(liPaging)">&#8249;</a>
                                    </li>
                                    <li class="page-item"
                                        ng-repeat="p in getPages(inspectionList.length, liPaging.size) track by $index"
                                        ng-class="{active: liPaging.current == p}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="setPage(liPaging, p)">{{p}}</a>
                                    </li>
                                    <li class="page-item" ng-class="{disabled: liPaging.current == getPages(inspectionList.length, liPaging.size).length}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="nextPage(liPaging, inspectionList.length)">&#8250;</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @Html.Partial("_FooterLayout")
    </div>
</main>
