@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@functions{
    public string GetAntiForgeryToken()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}
<script src="~/NgScript/Controller/customerHierarchyCtrl.js"></script>

<main class="main-content2 position-relative max-height-vh-100 h-100" ng-controller="customerHierarchyCtrl">
    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none" id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="@Url.Action("ManageCustomer", "Admin")">Manage Customer</a></li>
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">Manage Customer Hierarchy</li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserFullName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center"></div>
                <ul class="navbar-nav justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login", "Account")" class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4">
        <input id="antiForgeryToken" ng-model="antiForgeryToken" type="hidden" ng-init="antiForgeryToken='@GetAntiForgeryToken()'" />
        <input type="hidden" ng-model="customerId" ng-init="customerId='@Request.QueryString["id"]'" />
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mt-2">Location</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="row">
                                <div class="col-sm-2"><span>Location Name <span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="loc.locationName" maxlength="100" />
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Location Address</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="loc.customerAddress" maxlength="400" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2"><span>Country</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select name="country" id="drpcountry" class="form-control" ng-model="country" ng-change="GetProvincebyCountryId()">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="d in getAllCountries" value="{{d.CountryID}}">{{d.CountryName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Province</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select name="province" id="drpprovince" class="form-control" ng-model="province" ng-change="GetCitybyProvinceId()">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="d in getProvincebyCountryId" value="{{d.ProvinceID}}">{{d.ProvinceName}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2"><span>City</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select name="city" class="form-control" ng-model="city">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="d in getCitybyProvinceId" value="{{d.CityID}}">{{d.CityName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Pin</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="loc.pincode" maxlength="8" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2"><span>Region</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="loc.region" maxlength="100" />
                                    </div>
                                </div>
                                <div class="col-sm-2"></div>
                                <div class="col-sm-4"></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-12">
                                    <span class="text-danger" ng-show="locError">{{locError}}</span>
                                    <span class="text-success" ng-show="locSuccess">{{locSuccess}}</span>
                                </div>
                            </div>
                            <div class="text-center float-end mt-3">
                                <button type="button" ng-click="SaveLocation()" class="btn btn-lg bg-gradient-info btn-lg mt-2 mb-0">
                                    {{loc.customerLocationId > 0 ? 'Update Location' : 'Add Location'}}
                                </button>
                                <button type="button" ng-click="ClearLocation()" class="btn btn-lg bg-gradient-secondary btn-lg mt-2 mb-0 ms-2">Clear</button>
                            </div>
                        </form>

                        <div class="clearfix mb-3"></div>
                        <div class="table-responsive mt-4 p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2" style="display:none;"></th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Location ID</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Address</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Region</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="l in locationList | startFrom:(locPaging.current-1)*locPaging.size | limitTo:locPaging.size">
                                        <td style="display:none">{{l.CustomerLocationID}}</td>
                                        <td>{{l.LocationName}}</td>
                                        <td>{{l.CustomerAddress}}</td>
                                        <td>{{l.Region}}</td>
                                        <td>
                                            <a href="javascript:void(0)" ng-click="EditLocation(l)" title="Edit Location">
                                                <i class="material-icons opacity-10">edit</i>
                                            </a>
                                            &nbsp;
                                            <a href="javascript:void(0)" ng-click="DeleteLocation(l.CustomerLocationID)" title="Delete Location">
                                                <i class="material-icons opacity-10">delete</i>
                                            </a>
                                        </td>
                                    </tr>
                                    <tr ng-if="locationList.length == 0">
                                        <td colspan="5" class="text-center">No locations found.</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="d-flex justify-content-between align-items-center mt-2" ng-if="locationList.length > locPaging.size">
                                <span class="text-sm">
                                    Showing {{(locPaging.current-1)*locPaging.size+1}} -
                                    {{locPaging.current*locPaging.size > locationList.length ? locationList.length : locPaging.current*locPaging.size}}
                                    of {{locationList.length}}
                                </span>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item" ng-class="{disabled: locPaging.current == 1}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="prevPage(locPaging)">&#8249;</a>
                                    </li>
                                    <li class="page-item" ng-repeat="p in getPages(locationList.length, locPaging.size) track by $index"
                                        ng-class="{active: locPaging.current == p}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="setPage(locPaging, p)">{{p}}</a>
                                    </li>
                                    <li class="page-item" ng-class="{disabled: locPaging.current == getPages(locationList.length, locPaging.size).length}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="nextPage(locPaging, locationList.length)">&#8250;</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mt-2">Facility</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="row">
                                <div class="col-sm-2"><span>Location ID<span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select class="form-control" ng-model="fac.customerLocationId">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="l in locationList" value="{{l.CustomerLocationID}}">{{l.LocationName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Facility Name <span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="fac.facilityName" maxlength="150" />
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-12">
                                    <span class="text-danger" ng-show="facError">{{facError}}</span>
                                    <span class="text-success" ng-show="facSuccess">{{facSuccess}}</span>
                                </div>
                            </div>
                            <div class="text-center float-end mt-3">
                                <button type="button" ng-click="SaveFacility()" class="btn btn-lg bg-gradient-info btn-lg mt-2 mb-0">
                                    {{fac.customerFacilityId > 0 ? 'Update Facility' : 'Add Facility'}}
                                </button>
                                <button type="button" ng-click="ClearFacility()" class="btn btn-lg bg-gradient-secondary btn-lg mt-2 mb-0 ms-2">Clear</button>
                            </div>
                        </form>

                        <div class="clearfix mb-3"></div>
                        <div class="table-responsive mt-4">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Facility Name</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Location ID</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="f in facilityList | startFrom:(facPaging.current-1)*facPaging.size | limitTo:facPaging.size">
                                        <td>{{f.FacilityName}}</td>
                                        <td>{{GetLocationName(f.CustomerLocationID)}}</td>
                                        <td>
                                            <a href="javascript:void(0)" ng-click="EditFacility(f)" title="Edit Facility">
                                                <i class="material-icons opacity-10">edit</i>
                                            </a>
                                            &nbsp;
                                            <a href="javascript:void(0)" ng-click="DeleteFacility(f.CustomerFacilityID)" title="Delete Facility">
                                                <i class="material-icons opacity-10">delete</i>
                                            </a>
                                        </td>
                                    </tr>
                                    <tr ng-if="facilityList.length == 0">
                                        <td colspan="3" class="text-center">No facilities found.</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="d-flex justify-content-between align-items-center mt-2" ng-if="facilityList.length > facPaging.size">
                                <span class="text-sm">
                                    Showing {{(facPaging.current-1)*facPaging.size+1}} -
                                    {{facPaging.current*facPaging.size > facilityList.length ? facilityList.length : facPaging.current*facPaging.size}}
                                    of {{facilityList.length}}
                                </span>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item" ng-class="{disabled: facPaging.current == 1}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="prevPage(facPaging)">&#8249;</a>
                                    </li>
                                    <li class="page-item" ng-repeat="p in getPages(facilityList.length, facPaging.size) track by $index"
                                        ng-class="{active: facPaging.current == p}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="setPage(facPaging, p)">{{p}}</a>
                                    </li>
                                    <li class="page-item" ng-class="{disabled: facPaging.current == getPages(facilityList.length, facPaging.size).length}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="nextPage(facPaging, facilityList.length)">&#8250;</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mt-2">Area</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="row">
                                <div class="col-sm-2"><span>Location ID<span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select class="form-control" ng-model="area.customerLocationId" ng-change="FilterFacilitiesForArea()">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="l in locationList" value="{{l.CustomerLocationID}}">{{l.LocationName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Facility</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select class="form-control" ng-model="area.customerFacilityId">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="f in filteredFacilitiesForArea" value="{{f.CustomerFacilityID}}">{{f.FacilityName}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2"><span>Area Name <span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="area.areaName" maxlength="150" />
                                    </div>
                                </div>
                                <div class="col-sm-2"></div>
                                <div class="col-sm-4"></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-12">
                                    <span class="text-danger" ng-show="areaError">{{areaError}}</span>
                                    <span class="text-success" ng-show="areaSuccess">{{areaSuccess}}</span>
                                </div>
                            </div>
                            <div class="text-center float-end mt-3">
                                <button type="button" ng-click="SaveArea()" class="btn btn-lg bg-gradient-info btn-lg mt-2 mb-0">
                                    {{area.areaId > 0 ? 'Update Area' : 'Add Area'}}
                                </button>
                                <button type="button" ng-click="ClearArea()" class="btn btn-lg bg-gradient-secondary btn-lg mt-2 mb-0 ms-2">Clear</button>
                            </div>
                        </form>

                        <div class="clearfix mb-3"></div>
                        <div class="table-responsive mt-4">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Area Name</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Location ID</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Facility</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="a in areaList | startFrom:(areaPaging.current-1)*areaPaging.size | limitTo:areaPaging.size">
                                        <td>{{a.AreaName}}</td>
                                        <td>{{GetLocationName(a.CustomerLocationID)}}</td>
                                        <td>{{GetFacilityName(a.CustomerFacilityID)}}</td>
                                        <td>
                                            <a href="javascript:void(0)" ng-click="EditArea(a)" title="Edit Area">
                                                <i class="material-icons opacity-10">edit</i>
                                            </a>
                                            &nbsp;
                                            <a href="javascript:void(0)" ng-click="DeleteArea(a.AreaID)" title="Delete Area">
                                                <i class="material-icons opacity-10">delete</i>
                                            </a>
                                        </td>
                                    </tr>
                                    <tr ng-if="areaList.length == 0">
                                        <td colspan="4" class="text-center">No areas found.</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="d-flex justify-content-between align-items-center mt-2" ng-if="areaList.length > areaPaging.size">
                                <span class="text-sm">
                                    Showing {{(areaPaging.current-1)*areaPaging.size+1}} -
                                    {{areaPaging.current*areaPaging.size > areaList.length ? areaList.length : areaPaging.current*areaPaging.size}}
                                    of {{areaList.length}}
                                </span>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item" ng-class="{disabled: areaPaging.current == 1}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="prevPage(areaPaging)">&#8249;</a>
                                    </li>
                                    <li class="page-item" ng-repeat="p in getPages(areaList.length, areaPaging.size) track by $index"
                                        ng-class="{active: areaPaging.current == p}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="setPage(areaPaging, p)">{{p}}</a>
                                    </li>
                                    <li class="page-item" ng-class="{disabled: areaPaging.current == getPages(areaList.length, areaPaging.size).length}">
                                        <a class="page-link" href="javascript:void(0)" ng-click="nextPage(areaPaging, areaList.length)">&#8250;</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @Html.Partial("_FooterLayout")
    </div>
</main>