@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    bool isInventory = true;
}
<script src="~/Scripts/ui-bootstrap-tpls-0.11.0.js"></script>
<script>
    try {
        angular.module("myApp").filter("startFrom", function () {
            return function (input, start) {
                if (!Array.isArray(input)) return [];
                return input.slice(parseInt(start, 10) || 0);
            };
        });
    } catch(e) {}
</script>
<script src="~/NgScript/Controller/customerInventoryListingCtrl.js"></script>

<style>
    [ng-cloak] { display: none !important; }
</style>
<main ng-cloak class="main-content2 position-relative max-height-vh-100 h-100"
      ng-app="myApp" ng-controller="customerInventoryListingCtrl">

    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none"
         id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">
                        Spare Materials
                    </li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserFullName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center">
                    <div class="input-group input-group-outline">
                        <input type="search" class="form-control" placeholder="Type here..."
                               ng-model="search" id="example-search-input">
                    </div>
                </div>
                <ul class="navbar-nav justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login","Account")"
                           class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                    <li class="nav-item d-xl-none ps-3 d-flex align-items-center">
                        <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                            <div class="sidenav-toggler-inner">
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4">

        <div class="row" ng-if="pageError">
            <div class="col-12">
                <div class="alert alert-danger">{{pageError}}</div>
            </div>
        </div>

        @* Spare Materials Listing — no upload section for customers *@
        <div class="row">
            <div class="col-12">
                <div class="card my-4" id="tblSpareMaterials">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <div class="row">
                                <div class="col-6 d-flex align-items-center">
                                    <h6 class="text-white text-capitalize ps-3 mb-0">
                                        Spare Materials
                                    </h6>
                                </div>
                                <div class="col-6 d-flex align-items-center justify-content-end pe-3">
                                    <button type="button" ng-click="LoadFiles()"
                                            class="btn btn-sm bg-gradient-secondary mb-0">
                                        Refresh
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body pb-2">
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">File Name</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Area, Facility, Location</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Region</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Rows</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Created Date</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Created By</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Status</th>
                                        <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody ng-repeat="f in fileList | filter:search | startFrom:(currentPage-1)*itemsPerPage | limitTo:itemsPerPage">
                                    <tr>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs font-weight-bold">
                                                {{f.FileName}}
                                            </span>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs">
                                                {{f.AreaName}}
                                                <span ng-if="f.AreaName && (f.FacilityName || f.LocationName)">, </span>
                                                <span ng-if="f.FacilityName">
                                                    {{f.FacilityName}}
                                                    <span ng-if="f.LocationName">, </span>
                                                </span>
                                                {{f.LocationName}}
                                            </span>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs font-weight-bold">{{f.Region}}</span>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs font-weight-bold">
                                                {{f.RowCount | number}}
                                            </span>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs">{{f.UploadDate}}</span>
                                        </td>
                                        <td class="align-middle text-sm">
                                            <span class="text-secondary text-xs">{{f.UploadedBy}}</span>
                                        </td>
                                        <td>
                                            <div class="d-flex px-2 py-1">
                                                <div class="d-flex flex-column justify-content-center">
                                                    <h6 class="badge badge-sm bg-gradient-completed"
                                                        ng-show="f.Status=='Active'">
                                                        Active
                                                    </h6>
                                                    <h6 class="badge badge-sm bg-gradient-secondary"
                                                        ng-show="f.Status=='Inactive'">
                                                        Inactive
                                                    </h6>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="white-space:nowrap">
                                            @* Customer: only Grid (edit) and Export — no delete, no metadata edit *@
                                            <a href="@Url.Action("customerSpareMaterialGrid","Customer")?fileId={{f.FileID}}"
                                               title="Open Spare Material Editor">
                                                <i class="material-icons opacity-10">grid_on</i>
                                            </a>
                                            &nbsp;
                                            <a href="javascript:void(0)"
                                               ng-click="ExportFile(f.FileID)"
                                               title="Download Excel">
                                                <i class="material-icons opacity-10">download</i>
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                                <tbody ng-if="fileList.length == 0 && !loading">
                                    <tr>
                                        <td colspan="8" class="text-center py-4">
                                            No spare material files found.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <nav>
                                Show
                                <select ng-model="viewby"
                                        ng-change="setItemsPerPage(viewby)"
                                        style="height:25px">
                                    <option>5</option>
                                    <option>10</option>
                                    <option>20</option>
                                    <option>50</option>
                                </select>
                                of {{fileList.length}} Files
                                <pagination
                                    total-items="fileList.length"
                                    ng-model="currentPage"
                                    max-size="maxSize"
                                    class="pagination"
                                    rotate="false"
                                    num-pages="numPages"
                                    items-per-page="itemsPerPage"
                                    previous-text="&laquo;"
                                    next-text="&raquo;">
                                </pagination>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    @Html.Partial("_FooterLayout")
</main>
