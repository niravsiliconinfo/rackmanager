@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<script src="~/NgScript/Controller/trainingCenterCtrl.js"></script>

<main class="main-content2 position-relative max-height-vh-100 h-100 border-radius-lg"
      ng-controller="trainingCenterCtrl">
    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none border-radius-xl" id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="@Url.Action("Index","Customer")">Dashboard</a></li>
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">Webinar &amp; Blog</li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserFullName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center">
                    @*<div class="input-group input-group-outline">
                            <input type="search" class="form-control" placeholder="Type here..." ng-model="search" id="example-search-input">
                        </div>*@
                </div>
                <ul class="navbar-nav  justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login", "Account")" class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                    <li class="nav-item d-xl-none ps-3 d-flex align-items-center">
                        <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                            <div class="sidenav-toggler-inner">
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4">

        <!-- ---- WEBINARS ---- -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white ps-3 mt-2">
                                <i class="material-icons text-sm me-2" style="vertical-align:middle;">videocam</i>
                                Webinars
                            </h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="text-sm text-muted" ng-if="!webinarList || webinarList.length == 0">
                            No webinars available at this time.
                        </p>
                        <div class="row">
                            <div class="col-sm-6 col-lg-4 mb-4"
                                 ng-repeat="w in webinarList">
                                <div class="card h-100 shadow-sm border">
                                    <div class="card-body d-flex flex-column">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="icon icon-shape icon-sm bg-gradient-info shadow border-radius-md text-center me-3">
                                                <i class="material-icons text-white text-sm">play_circle</i>
                                            </div>
                                            <h6 class="mb-0 text-sm font-weight-bold">{{w.Title}}</h6>
                                        </div>
                                        <p class="text-sm text-muted flex-grow-1" ng-if="w.Description">{{w.Description}}</p>
                                        <a ng-if="w.ExternalLink" href="{{w.ExternalLink}}" target="_blank"
                                           class="btn bg-gradient-info btn-sm mb-0 mt-2">
                                            <i class="material-icons text-sm me-1" style="vertical-align:middle;">open_in_new</i>
                                            Watch Webinar
                                        </a>
                                        <span ng-if="!w.ExternalLink" class="text-sm text-muted mt-2">Link coming soon</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ---- BLOGS ---- -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white ps-3 mt-2">
                                <i class="material-icons text-sm me-2" style="vertical-align:middle;">article</i>
                                Blog Posts
                            </h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="text-sm text-muted" ng-if="!blogList || blogList.length == 0">
                            No blog posts available at this time.
                        </p>
                        <div class="row">
                            <div class="col-sm-6 col-lg-4 mb-4"
                                 ng-repeat="b in blogList">
                                <div class="card h-100 shadow-sm border">
                                    <div class="card-body d-flex flex-column">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="icon icon-shape icon-sm bg-gradient-dark shadow border-radius-md text-center me-3">
                                                <i class="material-icons text-white text-sm">menu_book</i>
                                            </div>
                                            <h6 class="mb-0 text-sm font-weight-bold">{{b.Title}}</h6>
                                        </div>
                                        <p class="text-sm text-muted flex-grow-1" ng-if="b.Description">{{b.Description}}</p>
                                        <a ng-if="b.ExternalLink" href="{{b.ExternalLink}}" target="_blank"
                                           class="btn bg-gradient-dark btn-sm mb-0 mt-2">
                                            <i class="material-icons text-sm me-1" style="vertical-align:middle;">open_in_new</i>
                                            Read Article
                                        </a>
                                        <span ng-if="!b.ExternalLink" class="text-sm text-muted mt-2">Link coming soon</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @Html.Partial("_FooterLayout")
    </div>
</main>
