@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<script src="~/NgScript/Controller/internalInspectionCtrl.js"></script>

<main class="main-content2 position-relative max-height-vh-100 h-100 border-radius-lg"
      ng-controller="internalInspectionCtrl">

    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none border-radius-xl" id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="@Url.Action("customerInternalInspectionListing", "Customer")">Internal Inspections</a></li>
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">{{inspectionId > 0 ? 'Edit Inspection' : 'New Inspection'}}</li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserFullName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center"></div>
                <ul class="navbar-nav justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login", "Account")" class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4" ng-init="inspectionId='@Request.QueryString["id"]'">

        <!-- ===================== HEADER SECTION ===================== -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mt-2">
                                {{inspectionId > 0 ? 'Edit Internal Inspection' : 'New Internal Inspection'}}
                            </h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Location + Inspection Date -->
                        <div class="row">
                            <div class="col-sm-2"><span>Location ID <span class="error">*</span></span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <select class="form-control" ng-model="form.customerLocationId"
                                            ng-change="onLocationChange()">
                                        <option value="">-- Select --</option>
                                        <option ng-repeat="l in locationList" value="{{l.CustomerLocationID}}">
                                            {{l.LocationName}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2"><span>Inspection Date</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <input type="date" class="form-control" ng-model="form.inspectionDate" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                        </div>

                        <!-- Facility + Area -->
                        <div class="row">
                            <div class="col-sm-2"><span>Facility</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <select class="form-control" ng-model="form.customerFacilityId"
                                            ng-change="onFacilityChange()">
                                        <option value="">-- Select --</option>
                                        <option ng-repeat="f in filteredFacilities" value="{{f.CustomerFacilityID}}">
                                            {{f.FacilityName}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2"><span>Area</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <select class="form-control" ng-model="form.customerAreaId">
                                        <option value="">-- Select --</option>
                                        <option ng-repeat="a in filteredAreas" value="{{a.AreaID}}">
                                            {{a.AreaName}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Inspection Number + Reported By -->
                        <div class="row">
                            <div class="col-sm-2"><span>Inspection Number</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <input type="text" class="form-control" ng-model="form.inspectionNumber"
                                           placeholder="Auto-generated on save" readonly />
                                </div>
                            </div>
                            <div class="col-sm-2"><span>Reported By</span></div>
                            <div class="col-sm-4">
                                <div class="input-group input-group-outline mb-3">
                                    <input type="text" class="form-control" ng-model="form.reportedBy"
                                           maxlength="150" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================== DEFICIENCY SECTION ===================== -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <div class="row">
                                <div class="col-6 d-flex align-items-center">
                                    <h6 class="text-white text-capitalize ps-3 mt-2">Deficiencies</h6>
                                </div>
                                <div class="col-6 text-end pe-4 d-flex align-items-center justify-content-end">
                                    <button type="button" class="btn bg-gradient-dark mb-0 mx-3"
                                            ng-click="AddDeficiency()">
                                        <i class="material-icons text-sm me-1" style="vertical-align:middle;">add</i>
                                        Add Deficiency
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="text-sm text-muted" ng-if="deficiencies.length == 0">
                            No deficiencies added yet. Click "Add Deficiency" to begin.
                        </p>

                        <div ng-repeat="def in deficiencies" class="border rounded p-3 mb-4">
                            <div class="row mb-2">
                                <div class="col-sm-11">
                                    <h6 class="text-sm font-weight-bold">Deficiency #{{$index + 1}}</h6>
                                </div>
                                <div class="col-sm-1 text-end">
                                    <a href="javascript:void(0)" ng-click="RemoveDeficiency($index)">
                                        <i class="material-icons text-sm text-danger">delete</i>
                                    </a>
                                </div>
                            </div>

                            <!-- Area + Row -->
                            <div class="row">
                                <div class="col-sm-2"><span>Area</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="def.Area"
                                                maxlength="150" />
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Row</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="def.Row" maxlength="100" />
                                    </div>
                                </div>
                            </div>

                            <!-- Aisle + Bay -->
                            <div class="row">
                                <div class="col-sm-2"><span>Aisle</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="def.Aisle" maxlength="100" />
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Bay</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="def.Bay" maxlength="100" />
                                    </div>
                                </div>
                            </div>

                            <!-- Level + Beam Location -->
                            <div class="row">
                                <div class="col-sm-2"><span>Level</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3 scroller">
                                        <ul class="navbar-nav form-control">
                                            <li ng-repeat="lvl in levelOptions">
                                                <label>
                                                    <input type="checkbox"
                                                           ng-checked="IsCSVSelected(def.BeamFrameLevel, lvl)"
                                                           ng-click="ToggleCSV(def, 'BeamFrameLevel', lvl)" />
                                                    {{lvl}}
                                                </label>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Beam Location</span></div>
                                <div class="col-sm-4">
                                    <ul class="navbar-nav form-control">
                                        <li ng-repeat="beam in beamLocationOptions">
                                            <label>
                                                <input type="checkbox"
                                                       ng-checked="IsCSVSelected(def.BeamLocation, beam)"
                                                       ng-click="ToggleCSV(def, 'BeamLocation', beam)" />
                                                {{beam}}
                                            </label>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Frame Side + Internal Assessment -->
                            <div class="row">
                                <div class="col-sm-2"><span>Frame Side</span></div>
                                <div class="col-sm-4">
                                    <ul class="navbar-nav form-control">
                                        <li ng-repeat="side in frameSideOptions">
                                            <label>
                                                <input type="checkbox"
                                                       ng-checked="IsCSVSelected(def.FrameSide, side)"
                                                       ng-click="ToggleCSV(def, 'FrameSide', side)" />
                                                {{side}}
                                            </label>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-sm-2"><span>Internal Assessment</span></div>
                                <div class="col-sm-4">
                                    <ul class="navbar-nav form-control">
                                        <li ng-repeat="assess in assessmentOptions">
                                            <label>
                                                <input type="radio"
                                                       ng-model="def.InternalAssessment"
                                                       value="{{assess}}" />
                                                {{assess}}
                                            </label>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Internal Action -->
                            <div class="row">
                                <div class="col-sm-2"><span>Internal Action</span></div>
                                <div class="col-sm-10">
                                    <ul class="navbar-nav form-control" style="display:flex; flex-direction:row; flex-wrap:wrap;">
                                        <li ng-repeat="action in actionOptions" class="me-4">
                                            <label>
                                                <input type="checkbox"
                                                       ng-checked="IsCSVSelected(def.InternalAction, action)"
                                                       ng-click="ToggleCSV(def, 'InternalAction', action)" />
                                                {{action}}
                                            </label>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Recommended Action -->
                            <div class="row mt-2">
                                <div class="col-sm-2"><span>Recommended Action</span></div>
                                <div class="col-sm-10">
                                    <div class="input-group input-group-outline mb-3">
                                        <textarea class="form-control" ng-model="def.RecommendedAction"
                                                  rows="2" maxlength="2000"
                                                  placeholder="Describe the recommended action"></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Engineer Review -->
                            <div class="row">
                                <div class="col-sm-2"><span>Engineer Review</span></div>
                                <div class="col-sm-10">
                                    <div class="form-check mt-1">
                                        <input class="form-check-input" type="checkbox"
                                               id="engReview_{{$index}}"
                                               ng-model="def.IsEngineerReviewRequested" />
                                        <label class="form-check-label" for="engReview_{{$index}}">
                                            Request Engineer Review ({{engineerReviewCost | currency:'$':2}})
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Photos for this deficiency -->
                            <div class="row mt-2">
                                <div class="col-sm-2"><span>Photos</span></div>
                                <div class="col-sm-10">
                                    <input type="file"
                                           id="defPhoto_{{$index}}"
                                           multiple accept="image/*"
                                           onchange="angular.element(this).scope().onDeficiencyPhotosSelected(this.files, this)" />
                                    <div class="mt-2">
                                        <!-- New photo previews -->
                                        <div ng-repeat="photo in def.previewPhotos track by $index"
                                             class="d-inline-block me-2 mb-2">
                                            <img ng-src="{{photo.src}}" alt="Photo"
                                                 style="width:100px;height:100px;object-fit:cover;border:1px solid #ccc;" />
                                            <div class="text-center">
                                                <button type="button" class="btn btn-sm btn-danger mt-1"
                                                        ng-click="RemoveDeficiencyPhoto(def, $index)">Remove</button>
                                            </div>
                                        </div>
                                        <!-- Existing photos (edit mode) -->
                                        <div ng-repeat="photo in def.Photos track by $index"
                                             class="d-inline-block me-2 mb-2" ng-if="def.Photos">
                                            <img ng-src="{{photo.PhotoFullUrl}}" alt="Photo"
                                                 style="width:100px;height:100px;object-fit:cover;border:1px solid #ccc;" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================== SUBMIT ===================== -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="text-danger mb-2" ng-show="formError">{{formError}}</div>
                <div class="text-success mb-2" ng-show="formSuccess">{{formSuccess}}</div>
                <button type="button" class="btn bg-gradient-info btn-lg mt-2 mb-0"
                        ng-click="SaveInspection()" ng-disabled="saving">
                    <span ng-if="!saving">{{inspectionId > 0 ? 'Update Inspection' : 'Submit Inspection'}}</span>
                    <span ng-if="saving">Saving...</span>
                </button>
                <a href="@Url.Action("customerInternalInspectionListing", "Customer")"
                   class="btn bg-gradient-secondary btn-lg mt-2 mb-0 ms-2">Cancel</a>
            </div>
        </div>

        @Html.Partial("_FooterLayout")
    </div>
</main>
