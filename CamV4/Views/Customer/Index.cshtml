@model CamV4.Models.CustomerDashboardGraphViewModel
@{
    ViewBag.Title = "Rack Manager - Rack Management Tool - cam|industrial";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}



<main class="main-content position-relative max-height-vh-100 h-100" ng-app="myApp" ng-controller="customerdashboardCtrl">

    <!-- Navbar -->
    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none" id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="javascript:;">Home</a></li>
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">Dashboard</li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserFullName"]!</h6>
            </nav>

            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center gap-2">
                    <div class="input-group input-group-outline">
                        <select class="form-control" id="selectedYearCustomer" name="year"
                                onchange="ChartDataByYearCustomer(this.value);">
                        </select>
                    </div>
                    <div class="input-group input-group-outline">
                        <select class="form-control" style=" min-width: 150px;"
                                id="custDash_locationDropdown"
                                ng-model="custDash_selectedLocationId"
                                ng-change="custDash_OnLocationChange()"
                                ng-disabled="custDash_isLoading">
                            <option value="">All Locations</option>
                            <option ng-repeat="loc in custDash_locationList"
                                    ng-value="loc.CustomerLocationID">
                                {{loc.LocationName}}
                            </option>
                        </select>
                    </div>
                    <div class="input-group input-group-outline">
                        <select class="form-control" style=" min-width: 150px;"
                                id="custDash_facilityDropdown"
                                ng-model="custDash_selectedFacilityId"
                                ng-change="custDash_OnFacilityChange()"
                                ng-disabled="custDash_isLoading">
                            <option value="">All Facilities</option>
                            <option ng-repeat="fac in custDash_facilityList"
                                    ng-value="fac.CustomerFacilityID">
                                {{fac.FacilityName}}
                            </option>
                        </select>
                    </div>
                </div>

                <ul class="navbar-nav justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login", "Account")" class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                    <li class="nav-item d-xl-none ps-3 d-flex align-items-center">
                        <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                            <div class="sidenav-toggler-inner">
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->

    <div class="container-fluid py-4">
        <div class="row">
            <div class="col mb-3">
                <div class="card-dashboard">
                    <div class="card-header p-1 pt-2">
                        <div class="icon icon-lg icon-shape text-center mt-n4 position-absolute">
                            <img src="~/Content/V2/images/d_InspectionsDue.png" style="height:64px;width:64px;" />
                        </div>
                        <div class="text-end pt-1">
                            <h4 class="mb-0">
                                <span ng-if="!custDash_isLoading || custDash_cnt.InspectionsDue > 0"
                                      ng-bind="custDash_cnt.InspectionsDue"></span>
                                <span ng-if="custDash_isLoading && custDash_cnt.InspectionsDue === 0"
                                      class="custdash-counter-skeleton"></span>
                            </h4>
                            <p class="text-sm mb-0 text-capitalize">Inspections Due</p>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0">
                    <div class="card-footer p-1">
                        <p class="text-sm mb-0 text-capitalize"><span class="text-dark text-sm font-weight-bolder">&nbsp;</span></p>
                    </div>
                </div>
            </div>
            <div class="col mb-3">
                <div class="card-dashboard">
                    <div class="card-header p-1 pt-2">
                        <div class="icon icon-lg icon-shape text-center mt-n4 position-absolute">
                            <img src="~/Content/V2/images/d_InProgress.png" style="height:64px;width:64px;" />
                        </div>
                        <div class="text-end pt-1">
                            <h4 class="mb-0">
                                <span ng-if="!custDash_isLoading || custDash_cnt.InProgress > 0"
                                      ng-bind="custDash_cnt.InProgress"></span>
                                <span ng-if="custDash_isLoading && custDash_cnt.InProgress === 0"
                                      class="custdash-counter-skeleton"></span>
                            </h4>
                            <p class="text-sm mb-0 text-capitalize">In Progress</p>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0">
                    <div class="card-footer p-1">
                        <p class="text-sm mb-0 text-capitalize"><span class="text-dark text-sm font-weight-bolder">&nbsp;</span></p>
                    </div>
                </div>
            </div>
            <div class="col mb-3">
                <div class="card-dashboard">
                    <div class="card-header p-1 pt-2">
                        <div class="icon icon-lg icon-shape text-center mt-n4 position-absolute">
                            <img src="~/Content/V2/images/d_SentForApproval.png" style="height:64px;width:64px;" />
                        </div>
                        <div class="text-end pt-1">
                            <h4 class="mb-0">
                                <span ng-if="!custDash_isLoading || custDash_cnt.SentForApproval > 0"
                                      ng-bind="custDash_cnt.SentForApproval"></span>
                                <span ng-if="custDash_isLoading && custDash_cnt.SentForApproval === 0"
                                      class="custdash-counter-skeleton"></span>
                            </h4>
                            <p class="text-sm mb-0 text-capitalize">Sent for Approval</p>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0">
                    <div class="card-footer p-1">
                        <p class="text-sm mb-0 text-capitalize"><span class="text-dark text-sm font-weight-bolder">&nbsp;</span></p>
                    </div>
                </div>
            </div>
            <div class="col mb-3">
                <div class="card-dashboard">
                    <div class="card-header p-1 pt-2">
                        <div class="icon icon-lg icon-shape text-center mt-n4 position-absolute">
                            <img src="~/Content/V2/images/d_ReportComplete.png" style="height:64px;width:64px;" />
                        </div>
                        <div class="text-end pt-1">
                            <h4 class="mb-0">
                                <span ng-if="!custDash_isLoading || custDash_cnt.ReportComplete > 0"
                                      ng-bind="custDash_cnt.ReportComplete"></span>
                                <span ng-if="custDash_isLoading && custDash_cnt.ReportComplete === 0"
                                      class="custdash-counter-skeleton"></span>
                            </h4>
                            <p class="text-sm mb-0 text-capitalize">Report Complete</p>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0">
                    <div class="card-footer p-1">
                        <p class="text-sm mb-0 text-capitalize"><span class="text-dark text-sm font-weight-bolder">&nbsp;</span></p>
                    </div>
                </div>
            </div>
            <div class="col mb-3">
                <div class="card-dashboard">
                    <div class="card-header p-1 pt-2">
                        <div class="icon icon-lg icon-shape text-center mt-n4 position-absolute">
                            <img src="~/Content/V2/images/d_QuotationRequested.png" style="height:64px;width:64px;" />
                        </div>
                        <div class="text-end pt-1">
                            <h4 class="mb-0">
                                <span ng-if="!custDash_isLoading || custDash_cnt.QuotationRequested > 0"
                                      ng-bind="custDash_cnt.QuotationRequested"></span>
                                <span ng-if="custDash_isLoading && custDash_cnt.QuotationRequested === 0"
                                      class="custdash-counter-skeleton"></span>
                            </h4>
                            <p class="text-sm mb-0 text-capitalize">Quotation Requested</p>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0">
                    <div class="card-footer p-1">
                        <p class="text-sm mb-0 text-capitalize"><span class="text-dark text-sm font-weight-bolder">&nbsp;</span></p>
                    </div>
                </div>
            </div>
            <div class="col mb-3">
                <div class="card-dashboard">
                    <div class="card-header p-1 pt-2">
                        <div class="icon icon-lg icon-shape text-center mt-n4 position-absolute">
                            <img src="~/Content/V2/images/d_AwaitingApproval.png" style="height:64px;width:64px;" />
                        </div>
                        <div class="text-end pt-1">
                            <h4 class="mb-0">
                                <span ng-if="!custDash_isLoading || custDash_cnt.AwaitingApproval > 0"
                                      ng-bind="custDash_cnt.AwaitingApproval"></span>
                                <span ng-if="custDash_isLoading && custDash_cnt.AwaitingApproval === 0"
                                      class="custdash-counter-skeleton"></span>
                            </h4>
                            <p class="text-sm mb-0 text-capitalize">Awaiting Approval</p>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0">
                    <div class="card-footer p-1">
                        <p class="text-sm mb-0 text-capitalize"><span class="text-dark text-sm font-weight-bolder">&nbsp;</span></p>
                    </div>
                </div>
            </div>
            <div class="col mb-3">
                <div class="card-dashboard">
                    <div class="card-header p-1 pt-2">
                        <div class="icon icon-lg icon-shape text-center mt-n4 position-absolute">
                            <img src="~/Content/V2/images/d_QuotationApproved.png" style="height:64px;width:64px;" />
                        </div>
                        <div class="text-end pt-1">
                            <h4 class="mb-0">
                                <span ng-if="!custDash_isLoading || custDash_cnt.QuotationApproved > 0"
                                      ng-bind="custDash_cnt.QuotationApproved"></span>
                                <span ng-if="custDash_isLoading && custDash_cnt.QuotationApproved === 0"
                                      class="custdash-counter-skeleton"></span>
                            </h4>
                            <p class="text-sm mb-0 text-capitalize">Quotation Approved</p>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0">
                    <div class="card-footer p-1">
                        <p class="text-sm mb-0 text-capitalize"><span class="text-dark text-sm font-weight-bolder">&nbsp;</span></p>
                    </div>
                </div>
            </div>
            <div class="col mb-3">
                <div class="card-dashboard">
                    <div class="card-header p-1 pt-2">
                        <div class="icon icon-lg icon-shape text-center mt-n4 position-absolute">
                            <img src="~/Content/V2/images/d_RepairCompleted.png" style="height:64px;width:64px;" />
                        </div>
                        <div class="text-end pt-1">
                            <h4 class="mb-0">
                                <span ng-if="!custDash_isLoading || custDash_cnt.RepairCompleted > 0"
                                      ng-bind="custDash_cnt.RepairCompleted"></span>
                                <span ng-if="custDash_isLoading && custDash_cnt.RepairCompleted === 0"
                                      class="custdash-counter-skeleton"></span>
                            </h4>
                            <p class="text-sm mb-0 text-capitalize">Repair Completed</p>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0">
                    <div class="card-footer p-1">
                        <p class="text-sm mb-0 text-capitalize"><span class="text-dark text-sm font-weight-bolder">&nbsp;</span></p>
                    </div>
                </div>
            </div>
            <div class="col mb-3">
                <div class="card-dashboard">
                    <div class="card-header p-1 pt-2">
                        <div class="icon icon-lg icon-shape text-center mt-n4 position-absolute">
                            <img src="~/Content/V2/images/d_Finished.png" style="height:64px;width:64px;" />
                        </div>
                        <div class="text-end pt-1">
                            <h4 class="mb-0">
                                <span ng-if="!custDash_isLoading || custDash_cnt.Finished > 0"
                                      ng-bind="custDash_cnt.Finished"></span>
                                <span ng-if="custDash_isLoading && custDash_cnt.Finished === 0"
                                      class="custdash-counter-skeleton"></span>
                            </h4>
                            <p class="text-sm mb-0 text-capitalize">Finished</p>
                        </div>
                    </div>
                    <hr class="dark horizontal my-0">
                    <div class="card-footer p-1">
                        <p class="text-sm mb-0 text-capitalize"><span class="text-dark text-sm font-weight-bolder">&nbsp;</span></p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-lg-4 col-md-6 mt-4 mb-4">
                <div class="card z-index-2">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2 bg-transparent">
                        <div class="bg-gradient-light shadow-info py-3 pe-1">
                            <div class="chart">
                                <canvas id="custdash-pie-chart" width="800" height="450"></canvas>
                                <canvas id="pie-chart-customer" width="1" height="1" style="display:none;"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <h6 class="mb-0">Deficiencies By Severity</h6>
                        <hr class="dark horizontal">
                        <div class="d-flex align-items-center">
                            <span ng-show="custDash_isLoading" class="text-xs text-secondary">
                                <i class="fa fa-spinner fa-spin me-1"></i>Updating…
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8 col-md-6 mt-4 mb-4">
                <div class="col-12">
                    <div class="card z-index-2">
                        <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                            <div class="pt-4 pb-4">
                                <div class="row">
                                    <div class="col-6 d-flex align-items-center">
                                        <h6 class="text-white text-capitalize ps-3 mb-0">Deficiencies Breakdown Based On Categories</h6>
                                    </div>
                                    <div class="col-6 text-end">
                                        <span ng-show="custDash_isLoading" class="text-white text-xs pe-3">
                                            <i class="fa fa-spinner fa-spin"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body pb-2">
                            <div class="table-responsive p-0">
                                <table class="table align-items-center mb-0">
                                    <thead>
                                        <tr>
                                            <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2 text-left">Deficiency Category</th>
                                            <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2 text-center">Minor</th>
                                            <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2 text-center">Intermediate</th>
                                            <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2 text-center">Major</th>
                                            <th class="text-dark text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2 text-center">Count</th>
                                        </tr>
                                    </thead>
                                    <tbody ng-repeat="d in custDash_categoryBreakdownList">
                                        <tr>
                                            <td class="align-middle text-left text-sm">
                                                <span class="text-secondary text-xs font-weight-bold">{{d.DeficiencyCategory}}</span>
                                            </td>
                                            <td class="align-middle text-center text-sm">
                                                <span class="text-secondary text-xs font-weight-bold">{{d.MinorCnt}}</span>
                                            </td>
                                            <td class="align-middle text-center text-sm">
                                                <span class="text-secondary text-xs font-weight-bold">{{d.IntermediateCnt}}</span>
                                            </td>
                                            <td class="align-middle text-center text-sm">
                                                <span class="text-secondary text-xs font-weight-bold">{{d.MajorCnt}}</span>
                                            </td>
                                            <td class="align-middle text-center text-sm">
                                                <span class="text-secondary text-xs font-weight-bold">{{d.TotalCnt}}</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tbody ng-if="custDash_categoryBreakdownList.length === 0 && !custDash_isLoading">
                                        <tr>
                                            <td colspan="5" class="text-center text-xs text-secondary py-3">
                                                No deficiency data for selected filters.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <hr class="dark horizontal">
                <div class="col-12">
                    <div class="card z-index-2">
                        <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                            <div class="pt-4 pb-4">
                                <div class="row">
                                    <div class="col-6 d-flex align-items-center">
                                        <h6 class="text-white text-capitalize ps-3 mb-0">Deficiencies Trend From Previous Years</h6>
                                    </div>
                                    <div class="col-6 text-end"></div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body pb-2">
                            <canvas id="custdash-trend-chart" width="400" height="200"></canvas>
                            <canvas id="deficiencyChart" width="1" height="1" style="display:none;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-4">
            <div class="row mb-4">
                <div class="col-lg-8 col-md-6 mb-md-0 mb-4">
                    <div class="card">
                        <div class="card-header pb-0">
                            <div class="row">
                                <div class="col-lg-6 col-7">
                                    <h6>Recent Inspection Status</h6>
                                </div>
                                <div class="col-lg-6 col-5 my-auto text-end"></div>
                            </div>
                        </div>
                        <div class="card-body px-0 pb-2">
                            <div class="table-responsive">
                                <table class="table align-items-center mb-0">
                                    <thead>
                                        <tr>
                                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Location and Area</th>
                                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Done By</th>
                                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Report Date</th>
                                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody ng-repeat="d in getRecentInspectionbyCustomerId">
                                        <tr ng-click="InspectionDetailClickByCustomer(d.InspectionId)">
                                            <td class="align-middle text-center text-sm">
                                                <p class="text-xs font-weight-bold mb-0">{{d.CustomerLocation}}</p>
                                                <p class="text-xs font-weight-bold mb-0">{{d.CustomerArea}}</p>
                                            </td>
                                            <td class="align-middle text-center text-sm">
                                                <p class="text-xs font-weight-bold mb-0">{{d.Employee}}</p>
                                            </td>
                                            <td class="align-middle text-center text-sm">
                                                <span class="text-xs font-weight-bold">{{d.Reportdate | date:'dd MMM yyyy'}}</span>
                                            </td>
                                            <td class="align-middle text-center text-sm">
                                                <h6 class="badge badge-sm bg-gradient-finished" ng-show="d.InspectionStatus == 9">Finished</h6>
                                                <h6 class="badge badge-sm bg-gradient-repaircompleted" ng-show="d.InspectionStatus == 8">Repair Completed</h6>
                                                <h6 class="badge badge-sm bg-gradient-quotationapproval" ng-show="d.InspectionStatus == 7">Quotation Approved</h6>
                                                <h6 class="badge badge-sm bg-gradient-quotationawaitingapproval" ng-show="d.InspectionStatus == 6">Awaiting Approval</h6>
                                                <h6 class="badge badge-sm bg-gradient-requestquotation" ng-show="d.InspectionStatus == 5">Quotation Requested</h6>
                                                <h6 class="badge badge-sm bg-gradient-completed" ng-show="d.InspectionStatus == 4">Completed</h6>
                                                <h6 class="badge badge-sm bg-gradient-sendforapproval" ng-show="d.InspectionStatus == 3">Send for Approval</h6>
                                                <h6 class="badge badge-sm bg-gradient-inprogress" ng-show="d.InspectionStatus == 2">In Progress</h6>
                                                <h6 class="badge badge-sm bg-gradient-due" ng-show="d.InspectionStatus == 1">Inspection Due</h6>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100">
                        <div class="card-header pb-0">
                            <h6>Inspection Due</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="timeline timeline-one-side" ng-repeat="d in getDueInspectionByCustomerId">
                                <div class="timeline-block mb-3">
                                    <span class="timeline-step">
                                        <i class="material-icons text-success text-gradient">notifications</i>
                                    </span>
                                    <div class="timeline-content">
                                        <h6 class="text-dark text-sm font-weight-bold mb-0">{{d.Customer}}</h6>
                                        <p class="text-secondary font-weight-bold text-xs mt-1 mb-0">{{d.Employee}}</p>
                                        <p class="text-secondary font-weight-bold text-xs mt-1 mb-0">{{d.CustomerLocation}}</p>
                                        <p class="text-secondary font-weight-bold text-xs mt-1 mb-0">{{d.InspectionDate | date: dd-MMM-yyyy}}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <footer class="footer py-4">
            <div class="container-fluid">
                <div class="row align-items-center justify-content-lg-between">
                    <div class="col-lg-6 mb-lg-0 mb-4">
                        <div class="copyright text-center text-sm text-muted text-lg-start">
                            ©
                            <script>document.write(new Date().getFullYear())</script>
                            <a href="https://camindustrial.net/" class="font-weight-bold" target="_blank">Cam Industrial</a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>
</main>

<div id="custdash-progress-bar"></div>

<div id="custdash-error-toast">
    <i class="fa fa-exclamation-circle me-1"></i> Failed to load dashboard data. Retrying…
</div>

<!--   Core JS Files   -->
<script src="~/assets/js/core/popper.min.js"></script>
<script src="~/assets/js/core/bootstrap.min.js"></script>
<script src="~/assets/js/plugins/perfect-scrollbar.min.js"></script>
<script src="~/assets/js/plugins/smooth-scrollbar.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/assets/js/plugins/chartjs.min.js"></script>
<script src="~/NgScript/Controller/customerdashboardCtrl.js"></script>

<script>
    //  Wire up AngularJS loader state → DOM progress bar + error toast
    //
    //   We use a MutationObserver on a hidden sentinel <span> that AngularJS
    //   adds/removes the class "ng-hide" to.  This is simpler and more reliable
    //   than an Angular $watch exposed to vanilla JS.
    //
    //   Alternatively, the controller calls custDash_uiShowLoader() /
    //   custDash_uiHideLoader() directly (see below).
    //

    var custDash_progressBar  = document.getElementById('custdash-progress-bar');
    var custDash_errorToast   = document.getElementById('custdash-error-toast');
    var custDash_errorTimer   = null;

    // Exposed so the AngularJS controller can call them directly
    window.custDash_uiShowLoader = function () {
        custDash_progressBar.classList.add('custdash-loading');
        custDash_errorToast.style.display = 'none';
        if (custDash_errorTimer) { clearTimeout(custDash_errorTimer); }
    };

    window.custDash_uiHideLoader = function () {
        custDash_progressBar.classList.remove('custdash-loading');
    };

    window.custDash_uiShowError = function () {
        custDash_progressBar.classList.remove('custdash-loading');
        custDash_errorToast.style.display = 'block';
        custDash_errorTimer = setTimeout(function () {
            custDash_errorToast.style.display = 'none';
        }, 5000);
    };

    //  Legacy pie/counter (year-only, unchanged)
    var dataList  = [];
    var lableList = [];
    var colorList = [];
    @if (Model.PieCusomter != null)
    {
        foreach (var dataInput in Model.PieCusomter.ToList())
        {
            var inspectionDeficiencyCnt = dataInput.InspectionDeficiencyCnt ?? 0;
            var classifications         = dataInput.Classifications ?? "Unknown";
            var classificationsColor    = dataInput.ClassificationsColor ?? "#FFFFFF";

            @:dataList.push("@inspectionDeficiencyCnt");
            @:lableList.push("@classifications");
            @:colorList.push("@classificationsColor");
        }
    }

    var win = navigator.platform.indexOf('Win') > -1;
    if (win && document.querySelector('#sidenav-scrollbar')) {
        Scrollbar.init(document.querySelector('#sidenav-scrollbar'), { damping: '0.5' });
    }

    // Build against the hidden canvas – no conflict with new charts
    var legacyPieConfig = {
        type: 'pie',
        data: { labels: lableList, datasets: [{ label: "Inspections", backgroundColor: colorList, data: dataList }] },
        options: { title: { display: true, text: '' } }
    };
    var myChart = new Chart(document.getElementById("pie-chart-customer"), legacyPieConfig);

    function ChartDataByYearCustomer(value) {
        var year = value.replace('number:', '');

        jQuery.ajax({
            type: "GET",
            url: '/api/pageview/getDeficienciesbySeverityCustomer',
            data: { year: year },
            success: function (response) {
                dataList  = response.map(function (e) { return e.InspectionDeficiencyCnt; });
                lableList = response.map(function (e) { return e.Classifications; });
                colorList = response.map(function (e) { return e.ClassificationsColor; });
                myChart.destroy();
                legacyPieConfig.data.labels                      = lableList;
                legacyPieConfig.data.datasets[0].data            = dataList;
                legacyPieConfig.data.datasets[0].backgroundColor = colorList;
                myChart = new Chart(document.getElementById("pie-chart-customer"), legacyPieConfig);
            }
        });

        // Counter cards are now driven by AngularJS – no jQuery .html() needed
    }
</script>
