@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@functions{
    public string GetAntiForgeryToken()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}
<script src="~/NgScript/Controller/customerHierarchyCtrl.js"></script>

<main class="main-content2 position-relative max-height-vh-100 h-100" ng-controller="customerHierarchyCtrl">
    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none" id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="@Url.Action("ManageCustomer", "Admin")">Dashboard</a></li>
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">Manage Customer Hierarchy</li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center"></div>
                <ul class="navbar-nav justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login", "Account")" class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4">
        <input id="antiForgeryToken" ng-model="antiForgeryToken" type="hidden" ng-init="antiForgeryToken='@GetAntiForgeryToken()'" />
        <input type="hidden" ng-model="customerId" ng-init="customerId='@Request.QueryString["id"]'" />

        <!-- ===================== LOCATION SECTION ===================== -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mt-2">Location</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="row">
                                <div class="col-sm-2"><span>Location Name <span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="loc.locationName" maxlength="100" />
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Location Address</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="loc.customerAddress" maxlength="400" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2"><span>Country</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select class="form-control" ng-model="loc.countryId" ng-change="GetProvinceByCountryId()">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="d in getAllCountries" value="{{d.CountryID}}">{{d.CountryName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Province</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select class="form-control" ng-model="loc.provinceId" ng-change="GetCityByProvinceId()">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="d in getProvinceByCountryId" value="{{d.ProvinceID}}">{{d.ProvinceName}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2"><span>City</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select class="form-control" ng-model="loc.cityId">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="d in getCityByProvinceId" value="{{d.CityID}}">{{d.CityName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Pin</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="loc.pincode" maxlength="8" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2"><span>Region</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="loc.region" maxlength="100" />
                                    </div>
                                </div>
                                <div class="col-sm-2"></div>
                                <div class="col-sm-4"></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-12">
                                    <span class="text-danger" ng-show="locError">{{locError}}</span>
                                    <span class="text-success" ng-show="locSuccess">{{locSuccess}}</span>
                                </div>
                            </div>
                            <div class="text-center float-end mt-3">
                                <button type="button" ng-click="SaveLocation()" class="btn btn-lg bg-gradient-info btn-lg mt-2 mb-0">
                                    {{loc.customerLocationId > 0 ? 'Update Location' : 'Add Location'}}
                                </button>
                                <button type="button" ng-click="ClearLocation()" class="btn btn-lg bg-gradient-secondary btn-lg mt-2 mb-0 ms-2">Clear</button>
                            </div>
                        </form>

                        <div class="clearfix mb-3"></div>
                        <div class="table-responsive mt-4">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Location ID</th>
                                        <th>Location Name</th>
                                        <th>Address</th>
                                        <th>Region</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="l in locationList">
                                        <td>{{l.CustomerLocationID}}</td>
                                        <td>{{l.LocationName}}</td>
                                        <td>{{l.CustomerAddress}}</td>
                                        <td>{{l.Region}}</td>
                                        <td>
                                            <button class="btn btn-primary btn-sm" ng-click="EditLocation(l)">Edit</button>
                                            <button class="btn btn-danger btn-sm ms-1" ng-click="DeleteLocation(l.CustomerLocationID)">Delete</button>
                                        </td>
                                    </tr>
                                    <tr ng-if="locationList.length == 0">
                                        <td colspan="5" class="text-center">No locations found.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================== FACILITY SECTION ===================== -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mt-2">Facility</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="row">
                                <div class="col-sm-2"><span>Location <span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select class="form-control" ng-model="fac.customerLocationId">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="l in locationList" value="{{l.CustomerLocationID}}">{{l.LocationName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Facility Name <span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="fac.facilityName" maxlength="150" />
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-12">
                                    <span class="text-danger" ng-show="facError">{{facError}}</span>
                                    <span class="text-success" ng-show="facSuccess">{{facSuccess}}</span>
                                </div>
                            </div>
                            <div class="text-center float-end mt-3">
                                <button type="button" ng-click="SaveFacility()" class="btn btn-lg bg-gradient-info btn-lg mt-2 mb-0">
                                    {{fac.customerFacilityId > 0 ? 'Update Facility' : 'Add Facility'}}
                                </button>
                                <button type="button" ng-click="ClearFacility()" class="btn btn-lg bg-gradient-secondary btn-lg mt-2 mb-0 ms-2">Clear</button>
                            </div>
                        </form>

                        <div class="clearfix mb-3"></div>
                        <div class="table-responsive mt-4">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Facility Name</th>
                                        <th>Location</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="f in facilityList">
                                        <td>{{f.FacilityName}}</td>
                                        <td>{{GetLocationName(f.CustomerLocationID)}}</td>
                                        <td>
                                            <button class="btn btn-primary btn-sm" ng-click="EditFacility(f)">Edit</button>
                                            <button class="btn btn-danger btn-sm ms-1" ng-click="DeleteFacility(f.CustomerFacilityID)">Delete</button>
                                        </td>
                                    </tr>
                                    <tr ng-if="facilityList.length == 0">
                                        <td colspan="3" class="text-center">No facilities found.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================== AREA SECTION ===================== -->
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-4">
                            <h6 class="text-white text-capitalize ps-3 mt-2">Area</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="row">
                                <div class="col-sm-2"><span>Location <span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select class="form-control" ng-model="area.customerLocationId" ng-change="FilterFacilitiesForArea()">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="l in locationList" value="{{l.CustomerLocationID}}">{{l.LocationName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2"><span>Facility (Optional)</span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <select class="form-control" ng-model="area.customerFacilityId">
                                            <option value="">-- Select --</option>
                                            <option ng-repeat="f in filteredFacilitiesForArea" value="{{f.CustomerFacilityID}}">{{f.FacilityName}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2"><span>Area Name <span class="text-danger">*</span></span></div>
                                <div class="col-sm-4">
                                    <div class="input-group input-group-outline mb-3">
                                        <input type="text" class="form-control" ng-model="area.areaName" maxlength="150" />
                                    </div>
                                </div>
                                <div class="col-sm-2"></div>
                                <div class="col-sm-4"></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-12">
                                    <span class="text-danger" ng-show="areaError">{{areaError}}</span>
                                    <span class="text-success" ng-show="areaSuccess">{{areaSuccess}}</span>
                                </div>
                            </div>
                            <div class="text-center float-end mt-3">
                                <button type="button" ng-click="SaveArea()" class="btn btn-lg bg-gradient-info btn-lg mt-2 mb-0">
                                    {{area.areaId > 0 ? 'Update Area' : 'Add Area'}}
                                </button>
                                <button type="button" ng-click="ClearArea()" class="btn btn-lg bg-gradient-secondary btn-lg mt-2 mb-0 ms-2">Clear</button>
                            </div>
                        </form>

                        <div class="clearfix mb-3"></div>
                        <div class="table-responsive mt-4">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Area Name</th>
                                        <th>Location</th>
                                        <th>Facility</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="a in areaList">
                                        <td>{{a.AreaName}}</td>
                                        <td>{{GetLocationName(a.CustomerLocationID)}}</td>
                                        <td>{{GetFacilityName(a.CustomerFacilityID)}}</td>
                                        <td>
                                            <button class="btn btn-primary btn-sm" ng-click="EditArea(a)">Edit</button>
                                            <button class="btn btn-danger btn-sm ms-1" ng-click="DeleteArea(a.AreaID)">Delete</button>
                                        </td>
                                    </tr>
                                    <tr ng-if="areaList.length == 0">
                                        <td colspan="4" class="text-center">No areas found.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="text-center float-sm-start mb-4">
                    <a href="@Url.Action("ManageCustomer", "Admin")" class="btn btn-lg bg-gradient-info btn-lg mt-4 mb-0">Back</a>
                </div>
            </div>
        </div>

        @Html.Partial("_FooterLayout")
    </div>
</main>