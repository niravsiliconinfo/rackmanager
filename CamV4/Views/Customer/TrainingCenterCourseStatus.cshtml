@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<script src="~/NgScript/Controller/trainingCenterCtrl.js"></script>

<main class="main-content2 position-relative max-height-vh-100 h-100 border-radius-lg"
      ng-controller="trainingCenterCtrl">
    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-4 shadow-none border-radius-xl" id="navbarBlur" navbar-scroll="true">
        <div class="container-fluid py-1 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
                    <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="@Url.Action("TrainingCenterRegistration","Customer")">Registration</a></li>
                    <li class="breadcrumb-item text-sm text-dark active" aria-current="page">Course Status</li>
                </ol>
                <h6 class="font-weight-bolder mb-0">Hello @Session["LoggedInUserFullName"]!</h6>
            </nav>
            <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
                <div class="ms-md-auto pe-md-3 d-flex align-items-center">
                    @*<div class="input-group input-group-outline">
                            <input type="search" class="form-control" placeholder="Type here..." ng-model="search" id="example-search-input">
                        </div>*@
                </div>
                <ul class="navbar-nav  justify-content-end">
                    <li class="nav-item d-flex align-items-center">
                        <a href="@Url.Action("Login", "Account")" class="nav-link text-body font-weight-bold px-0">
                            <i class="fa fa-sign-out me-sm-1"></i>
                            <span class="d-sm-inline d-none">Sign Out</span>
                        </a>
                    </li>
                    <li class="nav-item d-xl-none ps-3 d-flex align-items-center">
                        <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                            <div class="sidenav-toggler-inner">
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                                <i class="sidenav-toggler-line"></i>
                            </div>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4">

        <!-- ---- Single registration view (when id= in URL) ---- -->
        <div ng-if="selectedReg">
            <div class="row mb-3">
                <div class="col-12 d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("TrainingCenterCourseStatus","Customer")"
                       class="btn bg-gradient-secondary btn-sm mb-0">
                        <i class="material-icons text-sm me-1" style="vertical-align:middle;">arrow_back</i>All Registrations
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card my-4">
                        <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                            <div class="pt-4 pb-4">
                                <div class="row">
                                    <div class="col-8 d-flex align-items-center">
                                        <h6 class="text-white ps-3 mt-2">
                                            Registration - {{selectedReg.RegistrationDateFormatted}}
                                        </h6>
                                    </div>
                                    <div class="col-4 text-end pe-4 d-flex align-items-center justify-content-end">
                                        <span class="badge bg-gradient-warning" ng-if="selectedReg.Status=='Pending'">Pending</span>
                                        <span class="badge bg-gradient-info" ng-if="selectedReg.Status=='Confirmed'">Confirmed</span>
                                        <span class="badge bg-gradient-primary" ng-if="selectedReg.Status=='Enrolled'">Enrolled</span>
                                        <span class="badge bg-gradient-success" ng-if="selectedReg.Status=='Completed'">Completed</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered mb-0">
                                    <thead>
                                        <tr style="background:#003087;color:white;">
                                            <th class="text-sm">#</th>
                                            <th class="text-sm">Name</th>
                                            <th class="text-sm">Email</th>
                                            <th class="text-sm">Course</th>
                                            <th class="text-sm">Price</th>
                                            <th class="text-sm">Status</th>
                                            <th class="text-sm">Certificate</th>
                                            <th class="text-sm">Expiry</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="p in selectedReg.Persons">
                                            <td class="text-sm">{{$index + 1}}</td>
                                            <td class="text-sm">{{p.ContactName}}</td>
                                            <td class="text-sm">{{p.ContactEmail}}</td>
                                            <td class="text-sm">
                                                <span class="badge bg-gradient-dark me-1">{{p.CourseCode}}</span>
                                                {{p.CourseName}}
                                            </td>
                                            <td class="text-sm">{{p.CoursePriceFormatted}}</td>
                                            <td class="text-sm">
                                                <span class="badge bg-gradient-secondary" ng-if="p.CourseStatus=='Incomplete'">Incomplete</span>
                                                <span class="badge bg-gradient-success" ng-if="p.CourseStatus=='Complete'">Complete</span>
                                            </td>
                                            <td class="text-sm">
                                                <a ng-if="p.CertificateFullUrl" href="{{p.CertificateFullUrl}}"
                                                   target="_blank" class="btn btn-sm bg-gradient-info mb-0 py-1">
                                                    <i class="material-icons text-sm" style="vertical-align:middle;">download</i>
                                                    Download
                                                </a>
                                                <span ng-if="!p.CertificateFullUrl" class="text-sm text-muted">-</span>
                                            </td>
                                            <td class="text-sm">{{p.CertificateExpiryFormatted || '-'}}</td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr style="background:#f9f9f9;">
                                            <td colspan="4" class="text-sm font-weight-bold text-end">Total</td>
                                            <td class="text-sm font-weight-bold">{{selectedReg.TotalPriceFormatted}}</td>
                                            <td colspan="3"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="mt-3" ng-if="selectedReg.Notes">
                                <p class="text-sm"><strong>Notes from CAM Industrial:</strong> {{selectedReg.Notes}}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ---- All registrations list (no id= in URL) ---- -->
        <div ng-if="!selectedReg">
            <div class="row">
                <div class="col-12">
                    <div class="card my-4">
                        <div class="card-header card-blue p-0 position-relative mt-n4 mx-3 z-index-2">
                            <div class="pt-4 pb-4">
                                <h6 class="text-white ps-3 mt-2">Course Status - My Registrations</h6>
                            </div>
                        </div>
                        <div class="card-body pb-2">
                            <div class="table-responsive p-0">
                                <table class="table align-items-center mb-0">
                                    <thead>
                                        <tr>
                                            <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Date</th>
                                            <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Persons</th>
                                            <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Total</th>
                                            <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Notes</th>
                                            <th class="text-uppercase text-secondary text-sm font-weight-bolder opacity-7 ps-2">Status</th>
                                            <th class="text-secondary opacity-7"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-if="!registrationList || registrationList.length == 0">
                                            <td colspan="5" class="text-center text-sm py-3">No registrations found.</td>
                                        </tr>
                                        <tr ng-repeat="r in registrationList">
                                            <td><p class="text-sm mb-0 ps-2">{{r.RegistrationDateFormatted}}</p></td>
                                            <td class="text-center"><span class="badge bg-gradient-secondary">{{r.PersonCount}}</span></td>
                                            <td><p class="text-sm mb-0">{{r.TotalPriceFormatted}}</p></td>
                                            <td>
                                                <p class="text-sm mb-0">{{r.Notes}}</p>
                                            </td>
                                            </td>
                                            <td>
                                                <span class="badge bg-gradient-warning" ng-if="r.Status=='Pending'">Pending</span>
                                                <span class="badge bg-gradient-info" ng-if="r.Status=='Confirmed'">Confirmed</span>
                                                <span class="badge bg-gradient-primary" ng-if="r.Status=='Enrolled'">Enrolled</span>
                                                <span class="badge bg-gradient-success" ng-if="r.Status=='Completed'">Completed</span>
                                            </td>
                                            <td class="align-middle">
                                                <a href="/Customer/TrainingCenterCourseStatus?id={{r.TrainingRegistrationID}}"
                                                   title="View Details">
                                                    <i class="material-icons text-sm">visibility</i>
                                                </a>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @Html.Partial("_FooterLayout")
    </div>
</main>
