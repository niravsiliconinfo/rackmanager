    <script src="~/NgScript/Controller/sharedFilterService.js"></script>
    <script src="~/NgScript/Controller/menuCtrl.js"></script>
    <script>
        $.ajaxSetup({
            beforeSend: function (xhr) {
                var token = localStorage.getItem("token");

                if (token) {
                    xhr.setRequestHeader("Authorization", "Bearer " + token);
                }
            }
        });
    </script>
</head>

<style>
    #custdash-progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 0%;
        height: 3px;
        background: linear-gradient(90deg, #1A73E8, #42a5f5);
        z-index: 9999;
        transition: width 0.3s ease, opacity 0.4s ease;
        opacity: 0;
    }

        #custdash-progress-bar.custdash-loading {
            opacity: 1;
            animation: custdash-slide 1.4s ease-in-out infinite;
        }

    @@keyframes custdash-slide {
        0% {
            width: 0%;
            left: 0;
        }

        50% {
            width: 70%;
            left: 0;
        }

        100% {
            width: 100%;
            left: 0;
            opacity: 0;
        }
    }

    /*  Error toast  */
    #custdash-error-toast {
        position: fixed;
        top: 16px;
        right: 16px;
        background: #d32f2f;
        color: #fff;
        padding: 10px 18px;
        border-radius: 6px;
        font-size: 13px;
        z-index: 9999;
        box-shadow: 0 3px 10px rgba(0,0,0,.25);
        display: none;
    }

    /*  Skeleton shimmer for counters while loading  */
    .custdash-counter-skeleton {
        display: inline-block;
        width: 36px;
        height: 22px;
        background: linear-gradient(90deg, #e0e0e0 25%, #f5f5f5 50%, #e0e0e0 75%);
        background-size: 200% 100%;
        animation: custdash-shimmer 1.2s infinite;
        border-radius: 4px;
        vertical-align: middle;
    }

    @@keyframes custdash-shimmer {
        0% {
            background-position: 200% 0;
        }

        100% {
            background-position: -200% 0;
        }
    }

</style>
<body class="g-sidenav-show  bg-gray-200">    
    @RenderBody()
    <!--   Core JS Files   -->
    <script src="~/Content/V2/js/core/popper.min.js"></script>
    <script src="~/Content/V2/js/core/bootstrap.min.js"></script>
    <script src="~/Content/V2/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="~/Content/V2/js/plugins/smooth-scrollbar.min.js"></script>
    <!-- Github buttons -->
    <script src="~/Scripts/github_buttons.js"></script>
    <!-- Control Center for Material Dashboard: parallax effects, scripts for the example pages etc -->
    <script src="~/Content/V2/js/material-dashboard.min.js?v=3.0.2"></script>
    <script>
        var win = navigator.platform.indexOf('Win') > -1;
        if (win && document.querySelector('#sidenav-scrollbar')) {
            var options = {
                damping: '0.5'
            }
            Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
        }
    </script>
</body>
</html>

