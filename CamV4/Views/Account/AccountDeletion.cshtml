@{
    Layout = null; // Public/anonymous page - no shared _Layout, no auth required
    ViewBag.Title = "Rack Manager - Rack Management Tool - cam|industrial - Account Deletion Request";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    @* Reuse the same CSS/font stack the Login page uses (Material Dashboard / Material Kit based) *@
    <link href="~/Content/V2/css/nucleo-icons.css" rel="stylesheet" />
    <link href="~/Content/V2/css/nucleo-svg.css" rel="stylesheet" />
    <link href="~/Content/V2/css/material-dashboard.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/Content/V2/images/CamIndusIcon.png">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i" rel="stylesheet" />

    <style>
        /* Page-specific tweaks only - everything else comes from the shared theme CSS above */
        .account-deletion-card {
            max-width: 640px;
        }

        .section-title {
            color: #fff;
            font-weight: 700;
            margin: 24px 0 10px;
        }

            .section-title:first-of-type {
                margin-top: 8px;
            }

        .step-row {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            margin-bottom: 14px;
        }

        .step-num {
            flex: 0 0 auto;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #FFC72C;
            color: #003DA6;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .step-row p {
            color: rgba(255,255,255,0.85);
            margin: 0;
            font-size: 14px;
            line-height: 1.5;
        }

        .step-row strong {
            color: #fff;
            display: block;
            font-size: 15px;
        }

        .meta-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            font-size: 13px;
            color: #FFC72C;
            margin-bottom: 6px;
        }

        ul.plain-list {
            color: rgba(255,255,255,0.85);
            font-size: 14px;
            padding-left: 18px;
            line-height: 1.8;
            margin: 0;
        }

        hr.divider-light {
            border-color: rgba(255,255,255,0.15);
            margin: 22px 0;
        }

        .lead-text {
            color: rgba(255,255,255,0.85);
            font-size: 14px;
            line-height: 1.6;
        }

        #resultAlert {
            display: none;
        }

        .account-deletion-card .card-header img {
            max-height: 110px;
            width: auto;
        }
    </style>
</head>
<body>
    <div class="main-content mt-0">
        <div class="page-header align-items-start min-vh-100" style="background-image: url('../../Content/V2/images/CAM_RackApp_CoverImg.webp');">
            <span class="mask bg-gradient-dark opacity-6"></span>
            <div class="container my-auto">
                <div class="row">
                    <div class="col-lg-6 col-md-9 col-12 mx-auto" style="margin-top: 100px;margin-bottom: 100px;">
                        <div class="card-blue z-index-0 fadeIn3 fadeInBottom account-deletion-card">

                            <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                                <div class="p-3 text-center">
                                    <img src="~/Content/V2/images/logos/rack-manager-logo.png" class="img-fluid" alt="main_logo" style="max-height:110px; width:auto;">
                                </div>
                            </div>

                            <div class="card-body" style="background-color:#003DA6">

                                <h5 class="text-yellow font-weight-bolder mb-1">Account Rights</h5>
                                <h4 class="text-white font-weight-bolder mb-2">Account Deletion Request</h4>
                                <p class="lead-text">
                                    We respect your right to manage your personal data. Submitting this form will
                                    begin the process of permanently deleting your Rack Manager account and
                                    associated data from our systems.
                                </p>
                                <div class="meta-badges">
                                    <span>&#9993; support@cam-industrial.com</span>
                                    <span>&#128274; Verified Identity Required</span>
                                    <span>&#9200; Processing: 24&ndash;48h</span>
                                </div>

                                <hr class="divider-light" />

                                <h6 class="section-title">The Deletion Process</h6>
                                <div class="step-row">
                                    <div class="step-num">1</div>
                                    <p><strong>Submit Your Details</strong>Provide the user name and email associated with your account so we can locate your record.</p>
                                </div>
                                <div class="step-row">
                                    <div class="step-num">2</div>
                                    <p><strong>Identity Verification</strong>We may contact you to confirm your identity before any action is taken.</p>
                                </div>
                                <div class="step-row">
                                    <div class="step-num">3</div>
                                    <p><strong>Permanent Removal</strong>Once verified, your profile, credentials and associated data are permanently deleted, except where retention is required by law.</p>
                                </div>

                                <hr class="divider-light" />

                                <h6 class="section-title">Data Retention</h6>
                                <ul class="plain-list">
                                    <li>Certain transactional or audit records may be retained where legally required.</li>
                                    <li>Any outstanding balances or pending items should be resolved before submitting this request.</li>
                                </ul>

                                <hr class="divider-light" />

                                <h6 class="section-title">Request Deletion</h6>

                                <div id="resultAlert" class="alert" role="alert"></div>

                                <form role="form" id="accountDeletionForm" class="text-start">
                                    @Html.AntiForgeryToken()

                                    <div class="input-group input-group-outline my-3">
                                        <input type="text" id="FullName" name="FullName" placeholder="Full Name" class="form-control text-white" required="required">
                                    </div>
                                    <div class="input-group input-group-outline my-3">
                                        <input type="text" id="UserName" name="UserName" placeholder="User Name" class="form-control text-white" required="required">
                                    </div>
                                    <div class="input-group input-group-outline my-3">
                                        <input type="email" id="Email" name="Email" placeholder="Registered Account Email" class="form-control text-white" required="required">
                                    </div>
                                    <div class="input-group input-group-outline mb-3">
                                        <textarea id="Reason" name="Reason" placeholder="Reason for Deletion (Optional)" class="form-control text-white" rows="3"></textarea>
                                    </div>

                                    <div class="form-check form-switch d-flex align-items-center mb-3">
                                        <input class="form-check-input" type="checkbox" id="confirmDelete" name="confirmDelete" value="true" required="required">
                                        <label class="form-check-label mb-0 ms-2 text-white">I understand this action is permanent</label>
                                    </div>

                                    <div class="text-center">
                                        <button type="submit" id="btnSubmitDeletion" class="btn border-yellow text-yellow w-100 my-4 mb-2">
                                            Confirm Permanent Deletion
                                        </button>
                                    </div>
                                    <span class="text-yellow">Version 5.00.43</span>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src=~/NgScript/Controller/account-deletion.js"></script>
</body>
</html>
